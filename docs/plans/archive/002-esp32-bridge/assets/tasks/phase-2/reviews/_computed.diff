diff --git a/firmware/lib/knob_core/src/bluos_xml.cpp b/firmware/lib/knob_core/src/bluos_xml.cpp
new file mode 100644
index 0000000..c48302b
--- /dev/null
+++ b/firmware/lib/knob_core/src/bluos_xml.cpp
@@ -0,0 +1,124 @@
+#include "bluos_xml.h"
+
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+
+namespace knob {
+namespace {
+
+std::string decode_entities(const std::string& in) {
+    static const struct {
+        const char* entity;
+        char ch;
+    } kEntities[] = {{"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'}, {"&quot;", '"'}, {"&apos;", '\''}};
+    std::string out;
+    out.reserve(in.size());
+    for (size_t i = 0; i < in.size(); ++i) {
+        bool replaced = false;
+        if (in[i] == '&') {
+            for (const auto& e : kEntities) {
+                const size_t n = std::char_traits<char>::length(e.entity);
+                if (in.compare(i, n, e.entity) == 0) {
+                    out += e.ch;
+                    i += n - 1;
+                    replaced = true;
+                    break;
+                }
+            }
+        }
+        if (!replaced) out += in[i];
+    }
+    return out;
+}
+
+// Start of the root element's open tag, after any <?xml ...?> prolog.
+size_t root_start(const std::string& xml, const char* name) {
+    size_t pos = 0;
+    while ((pos = xml.find('<', pos)) != std::string::npos) {
+        if (xml.compare(pos, 2, "<?") == 0) {
+            pos = xml.find("?>", pos);
+            if (pos == std::string::npos) return std::string::npos;
+            continue;
+        }
+        const std::string open = std::string("<") + name;
+        if (xml.compare(pos, open.size(), open) == 0) {
+            const char next = pos + open.size() < xml.size() ? xml[pos + open.size()] : '\0';
+            if (next == ' ' || next == '>' || next == '/') return pos;
+        }
+        return std::string::npos;
+    }
+    return std::string::npos;
+}
+
+bool attribute(const std::string& xml, size_t tag_start, const char* name, std::string* out) {
+    const size_t tag_end = xml.find('>', tag_start);
+    if (tag_end == std::string::npos) return false;
+    const std::string needle = std::string(" ") + name + "=\"";
+    const size_t at = xml.find(needle, tag_start);
+    if (at == std::string::npos || at > tag_end) return false;
+    const size_t value_start = at + needle.size();
+    const size_t value_end = xml.find('"', value_start);
+    if (value_end == std::string::npos || value_end > tag_end) return false;
+    *out = decode_entities(xml.substr(value_start, value_end - value_start));
+    return true;
+}
+
+// Text of the first <name>...</name> child (exact tag name, so <title1> never matches <twoline_title1>).
+bool element(const std::string& xml, const char* name, std::string* out) {
+    const std::string open = std::string("<") + name + ">";
+    const std::string close = std::string("</") + name + ">";
+    const size_t start = xml.find(open);
+    if (start == std::string::npos) return false;
+    const size_t text_start = start + open.size();
+    const size_t end = xml.find(close, text_start);
+    if (end == std::string::npos) return false;
+    *out = decode_entities(xml.substr(text_start, end - text_start));
+    return true;
+}
+
+bool parse_finite(const std::string& text, double* out) {
+    if (text.empty()) return false;
+    errno = 0;
+    char* end = nullptr;
+    const double value = std::strtod(text.c_str(), &end);
+    if (errno != 0 || end != text.c_str() + text.size() || !std::isfinite(value)) return false;
+    *out = value;
+    return true;
+}
+
+}  // namespace
+
+VolumeInfo parse_volume(const std::string& xml) {
+    VolumeInfo info;
+    const size_t root = root_start(xml, "volume");
+    if (root == std::string::npos) return info;
+    std::string db, mute;
+    if (!attribute(xml, root, "db", &db) || !parse_finite(db, &info.db)) return info;
+    info.mute = attribute(xml, root, "mute", &mute) && mute == "1";
+    const size_t text_start = xml.find('>', root);
+    const size_t text_end = xml.find("</volume>", text_start);
+    double level = 0;
+    if (text_start != std::string::npos && text_end != std::string::npos &&
+        parse_finite(xml.substr(text_start + 1, text_end - text_start - 1), &level)) {
+        info.level = static_cast<int>(level);
+    }
+    info.ok = true;
+    return info;
+}
+
+StatusInfo parse_status(const std::string& xml) {
+    StatusInfo info;
+    if (root_start(xml, "status") == std::string::npos) return info;
+    element(xml, "service", &info.service);
+    element(xml, "title1", &info.title);
+    element(xml, "inputTypeIndex", &info.input_type_index);
+    element(xml, "state", &info.state);
+    std::string text;
+    info.has_db = element(xml, "db", &text) && parse_finite(text, &info.db);
+    info.mute = element(xml, "mute", &text) && text == "1";
+    info.ok = true;
+    return info;
+}
+
+}  // namespace knob
diff --git a/firmware/lib/knob_core/src/bluos_xml.h b/firmware/lib/knob_core/src/bluos_xml.h
new file mode 100644
index 0000000..79cef74
--- /dev/null
+++ b/firmware/lib/knob_core/src/bluos_xml.h
@@ -0,0 +1,29 @@
+// Field extraction from BluOS /Volume and /Status XML. Portable, allocation-light, no XML library.
+#pragma once
+
+#include <string>
+
+namespace knob {
+
+struct VolumeInfo {
+    bool ok = false;  // false when db is missing or not a finite number
+    double db = 0;
+    bool mute = false;
+    int level = -1;
+};
+
+struct StatusInfo {
+    bool ok = false;
+    std::string service;
+    std::string title;  // title1, entity-decoded
+    std::string input_type_index;
+    std::string state;
+    bool has_db = false;
+    double db = 0;
+    bool mute = false;
+};
+
+VolumeInfo parse_volume(const std::string& xml);
+StatusInfo parse_status(const std::string& xml);
+
+}  // namespace knob
diff --git a/firmware/lib/knob_core/src/config.cpp b/firmware/lib/knob_core/src/config.cpp
new file mode 100644
index 0000000..ccc910f
--- /dev/null
+++ b/firmware/lib/knob_core/src/config.cpp
@@ -0,0 +1,75 @@
+#include "config.h"
+
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+
+namespace knob {
+namespace {
+
+bool parse_number(const std::string& text, double* out) {
+    if (text.empty()) return false;
+    errno = 0;
+    char* end = nullptr;
+    const double value = std::strtod(text.c_str(), &end);
+    if (errno != 0 || end != text.c_str() + text.size() || !std::isfinite(value)) return false;
+    *out = value;
+    return true;
+}
+
+}  // namespace
+
+std::string validate_config(const Config& c) {
+    if (c.wifi_ssid.empty()) return "Wi-Fi not set up (run just fw-wifi)";
+    if (c.wifi_ssid.size() > 32) return "Wi-Fi name longer than 32 characters";
+    if (c.wifi_pass.size() > 64) return "Wi-Fi password longer than 64 characters";
+    if (c.host.empty()) return "amp address not set (run just fw-wifi)";
+    if (c.port < 1 || c.port > 65535) return "amp port must be 1-65535";
+    if (c.max_db > -24) return "max_db must be -24 dB or lower";
+    if (c.source_safe_db > -24) return "source_safe_db must be -24 dB or lower";
+    if (!(c.step_db > 0 && c.step_db <= 3)) return "step_db must be above 0 and at most 3 dB";
+    if (c.optical_input.empty()) return "optical_input not set";
+    if (c.spotify_source.empty()) return "spotify_source not set";
+    return "";
+}
+
+std::string apply_setting(Config& config, const std::string& key, const std::string& value) {
+    Config next = config;
+    double number = 0;
+    if (key == "wifi_ssid") {
+        next.wifi_ssid = value;
+        if (value.empty() || value.size() > 32) return "wifi_ssid must be 1-32 characters";
+    } else if (key == "wifi_pass") {
+        next.wifi_pass = value;
+        if (value.size() > 64) return "wifi_pass must be at most 64 characters";
+    } else if (key == "host") {
+        next.host = value;
+        if (value.empty()) return "host must not be empty";
+    } else if (key == "port") {
+        if (!parse_number(value, &number) || number != std::floor(number) || number < 1 || number > 65535)
+            return "port must be a whole number 1-65535";
+        next.port = static_cast<int>(number);
+    } else if (key == "max_db" || key == "source_safe_db" || key == "step_db") {
+        if (!parse_number(value, &number)) return key + " must be a number";
+        if (key == "max_db") next.max_db = number;
+        if (key == "source_safe_db") next.source_safe_db = number;
+        if (key == "step_db") next.step_db = number;
+        if (key == "max_db" && number > -24) return "max_db must be -24 dB or lower";
+        if (key == "source_safe_db" && number > -24) return "source_safe_db must be -24 dB or lower";
+        if (key == "step_db" && !(number > 0 && number <= 3)) return "step_db must be above 0 and at most 3 dB";
+    } else if (key == "optical_input") {
+        if (value.empty()) return "optical_input must not be empty";
+        next.optical_input = value;
+    } else if (key == "spotify_source") {
+        if (value.empty()) return "spotify_source must not be empty";
+        next.spotify_source = value;
+    } else {
+        return "unknown setting: " + key;
+    }
+    config = next;
+    return "";
+}
+
+bool is_secret_key(const std::string& key) { return key == "wifi_pass"; }
+
+}  // namespace knob
diff --git a/firmware/lib/knob_core/src/config.h b/firmware/lib/knob_core/src/config.h
new file mode 100644
index 0000000..8c62124
