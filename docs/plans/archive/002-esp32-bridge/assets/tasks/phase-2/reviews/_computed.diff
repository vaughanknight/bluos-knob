diff --git a/firmware/src/bluos_client.cpp b/firmware/src/bluos_client.cpp
new file mode 100644
index 0000000..f533881
--- /dev/null
+++ b/firmware/src/bluos_client.cpp
@@ -0,0 +1,97 @@
+#include "bluos_client.h"
+
+#include <Arduino.h>
+#include <HTTPClient.h>
+#include <WiFi.h>
+#include <freertos/semphr.h>
+
+#include "timing.h"
+
+namespace {
+
+constexpr uint32_t kPollMs = 2000;
+constexpr uint32_t kHttpTimeoutMs = 2000;
+
+std::string g_host;
+int g_port = 11000;
+AmpState g_state;
+SemaphoreHandle_t g_lock = nullptr;
+
+bool http_get(const char* path, std::string* body, std::string* error) {
+    HTTPClient http;
+    const String url = String("http://") + g_host.c_str() + ":" + g_port + path;
+    http.setConnectTimeout(kHttpTimeoutMs);
+    http.setTimeout(kHttpTimeoutMs);
+    if (!http.begin(url)) {
+        *error = "bad amp address";
+        return false;
+    }
+    const int code = http.GET();
+    if (code != 200) {
+        *error = code < 0 ? std::string("can't reach amp ") + g_host : "amp replied HTTP " + std::to_string(code);
+        http.end();
+        return false;
+    }
+    *body = http.getString().c_str();
+    http.end();
+    return true;
+}
+
+void poll_task(void*) {
+    knob::Backoff backoff(kPollMs, 30000);
+    for (;;) {
+        uint32_t wait = kPollMs;
+        if (WiFi.status() == WL_CONNECTED) {
+            std::string body, error;
+            knob::VolumeInfo volume;
+            knob::StatusInfo status;
+            bool ok = http_get("/Volume", &body, &error);
+            if (ok) {
+                volume = knob::parse_volume(body);
+                if (!volume.ok) {
+                    ok = false;
+                    error = "amp sent an unreadable volume";
+                }
+            }
+            if (ok && http_get("/Status", &body, &error)) status = knob::parse_status(body);
+            xSemaphoreTake(g_lock, portMAX_DELAY);
+            if (ok) {
+                g_state.reachable = true;
+                g_state.have_data = true;
+                g_state.volume = volume;
+                if (status.ok) g_state.status = status;
+                g_state.error.clear();
+                g_state.updated_ms = millis();
+                g_state.failures = 0;
+                backoff.on_success();
+            } else {
+                g_state.reachable = false;
+                g_state.error = error;
+                g_state.failures++;
+                wait = backoff.on_failure();
+            }
+            xSemaphoreGive(g_lock);
+            if (!ok) Serial.printf("{\"amp\":\"unreachable\",\"error\":\"%s\",\"retry_ms\":%lu}\n", error.c_str(),
+                                   static_cast<unsigned long>(wait));
+        }
+        vTaskDelay(pdMS_TO_TICKS(wait));
+    }
+}
+
+}  // namespace
+
+void bluos_start(const std::string& host, int port) {
+    g_host = host;
+    g_port = port;
+    g_lock = xSemaphoreCreateMutex();
+    xTaskCreatePinnedToCore(poll_task, "bluos", 8192, nullptr, 1, nullptr, 1);
+}
+
+AmpState bluos_snapshot() {
+    AmpState copy;
+    if (g_lock == nullptr) return copy;
+    xSemaphoreTake(g_lock, portMAX_DELAY);
+    copy = g_state;
+    xSemaphoreGive(g_lock);
+    return copy;
+}
diff --git a/firmware/src/bluos_client.h b/firmware/src/bluos_client.h
new file mode 100644
index 0000000..03a496c
--- /dev/null
+++ b/firmware/src/bluos_client.h
@@ -0,0 +1,19 @@
+// Read-only BluOS poller. Runs in its own FreeRTOS task so HTTP timeouts never stall the UI or BLE.
+#pragma once
+
+#include <string>
+
+#include "bluos_xml.h"
+
+struct AmpState {
+    bool reachable = false;
+    bool have_data = false;
+    knob::VolumeInfo volume;
+    knob::StatusInfo status;
+    std::string error;       // last failure, plain words
+    uint32_t updated_ms = 0;
+    uint32_t failures = 0;
+};
+
+void bluos_start(const std::string& host, int port);
+AmpState bluos_snapshot();
diff --git a/firmware/src/config_store.cpp b/firmware/src/config_store.cpp
new file mode 100644
index 0000000..a8da895
--- /dev/null
+++ b/firmware/src/config_store.cpp
@@ -0,0 +1,38 @@
+#include "config_store.h"
+
+#include <Preferences.h>
+
+namespace {
+constexpr const char* kNamespace = "bluos-knob";
+}
+
+void config_load(knob::Config& c) {
+    Preferences p;
+    p.begin(kNamespace, true);
+    c.wifi_ssid = p.getString("wifi_ssid", c.wifi_ssid.c_str()).c_str();
+    c.wifi_pass = p.getString("wifi_pass", c.wifi_pass.c_str()).c_str();
+    c.host = p.getString("host", c.host.c_str()).c_str();
+    c.port = p.getInt("port", c.port);
+    c.max_db = p.getDouble("max_db", c.max_db);
+    c.source_safe_db = p.getDouble("src_safe_db", c.source_safe_db);
+    c.step_db = p.getDouble("step_db", c.step_db);
+    c.optical_input = p.getString("optical_input", c.optical_input.c_str()).c_str();
+    c.spotify_source = p.getString("spotify_src", c.spotify_source.c_str()).c_str();
+    p.end();
+}
+
+bool config_save(const knob::Config& c) {
+    Preferences p;
+    if (!p.begin(kNamespace, false)) return false;
+    bool ok = p.putString("wifi_ssid", c.wifi_ssid.c_str()) == c.wifi_ssid.size();
+    ok = (p.putString("wifi_pass", c.wifi_pass.c_str()) == c.wifi_pass.size()) && ok;
+    ok = (p.putString("host", c.host.c_str()) == c.host.size()) && ok;
+    ok = p.putInt("port", c.port) > 0 && ok;
+    ok = p.putDouble("max_db", c.max_db) > 0 && ok;
+    ok = p.putDouble("src_safe_db", c.source_safe_db) > 0 && ok;
+    ok = p.putDouble("step_db", c.step_db) > 0 && ok;
+    ok = p.putString("optical_input", c.optical_input.c_str()) == c.optical_input.size() && ok;
+    ok = p.putString("spotify_src", c.spotify_source.c_str()) == c.spotify_source.size() && ok;
+    p.end();
+    return ok;
+}
