+++ b/firmware/lib/knob_core/src/config.h
@@ -0,0 +1,28 @@
+// Device configuration and its validation. Portable; persisted by the NVS adapter.
+#pragma once
+
+#include <string>
+
+namespace knob {
+
+struct Config {
+    std::string wifi_ssid;
+    std::string wifi_pass;
+    std::string host;
+    int port = 11000;
+    double max_db = -24;
+    double source_safe_db = -40;
+    double step_db = 1;
+    std::string optical_input = "optical-2";
+    std::string spotify_source = "Spotify";
+};
+
+// Empty string when valid, else the first problem in plain words.
+std::string validate_config(const Config& config);
+
+// Applies one `set <key> <value>`; leaves config untouched and returns an error when the value is invalid.
+std::string apply_setting(Config& config, const std::string& key, const std::string& value);
+
+bool is_secret_key(const std::string& key);
+
+}  // namespace knob
diff --git a/firmware/lib/knob_core/src/timing.cpp b/firmware/lib/knob_core/src/timing.cpp
new file mode 100644
index 0000000..fcb16d9
--- /dev/null
+++ b/firmware/lib/knob_core/src/timing.cpp
@@ -0,0 +1,17 @@
+#include "timing.h"
+
+namespace knob {
+
+uint32_t Backoff::on_failure() {
+    const uint32_t wait = next_;
+    next_ = (next_ > max_ / 2) ? max_ : next_ * 2;
+    return wait;
+}
+
+void Backoff::on_success() { next_ = min_; }
+
+void Dimmer::touch(uint32_t now_ms) { last_ = now_ms; }
+
+bool Dimmer::dimmed(uint32_t now_ms) const { return static_cast<uint32_t>(now_ms - last_) >= after_; }
+
+}  // namespace knob
diff --git a/firmware/lib/knob_core/src/timing.h b/firmware/lib/knob_core/src/timing.h
new file mode 100644
index 0000000..97b26c9
--- /dev/null
+++ b/firmware/lib/knob_core/src/timing.h
@@ -0,0 +1,30 @@
+// Clock-free timing helpers; callers pass millis() so tests can drive time.
+#pragma once
+
+#include <cstdint>
+
+namespace knob {
+
+class Backoff {
+   public:
+    Backoff(uint32_t min_ms, uint32_t max_ms) : min_(min_ms), max_(max_ms), next_(min_ms) {}
+    uint32_t on_failure();  // returns the delay to wait before the next attempt
+    void on_success();
+    uint32_t next() const { return next_; }
+
+   private:
+    uint32_t min_, max_, next_;
+};
+
+class Dimmer {
+   public:
+    explicit Dimmer(uint32_t dim_after_ms) : after_(dim_after_ms) {}
+    void touch(uint32_t now_ms);
+    bool dimmed(uint32_t now_ms) const;
+
+   private:
+    uint32_t after_;
+    uint32_t last_ = 0;
+};
+
+}  // namespace knob
