+#include <unity.h>
+
+#include <string>
+
+#include "bluos_xml.h"
+
+// Captured from the NAD M33 (192.168.1.67) on 2026-11-17; copies in tests/fixtures/bluos/.
+static const std::string kVolumeXml =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<volume db=\"-39\" offsetDb=\"0\" mute=\"0\" etag=\"d7429bdf863af05d666c68ec4474a85c\" source=\"\">70</volume>";
+static const std::string kStatusXml =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<status etag=\"0726818f8cc9f7334224ef8d04e55983\"><actions><action name=\"back\"></action></actions>"
+    "<canSeek>0</canSeek><currentImage>/images/capture/ic_opticalinputNP.png</currentImage><cursor>0</cursor>"
+    "<db>-39</db><image>/images/capture/ic_opticalinputNP.png</image><indexing>0</indexing>"
+    "<inputId>xdynamic-Source1</inputId><inputTypeIndex>optical-1</inputTypeIndex><mid>0</mid><mode>1</mode>"
+    "<mute>0</mute><pid>31</pid><prid>0</prid><repeat>2</repeat><secs>98670</secs><service>Capture</service>"
+    "<serviceType>AudioInputs</serviceType><settingsGroupId>capture-xdynamic-Source1</settingsGroupId>"
+    "<shuffle>0</shuffle><sid>6</sid><sleep></sleep><song>0</song><state>stream</state>"
+    "<stationImage>/images/capture/ic_opticalinputNP.png</stationImage>"
+    "<streamUrl>Capture:hw:imxnadadc,0/1/25/2?id=xdynamic-Source1</streamUrl><syncStat>1155</syncStat>"
+    "<title1>Optical 1</title1><twoline_title1>Optical 1</twoline_title1><volume>70</volume></status>";
+
+void setUp() {}
+void tearDown() {}
+
+void given_real_volume_response_when_parsed_then_db_mute_level() {
+    /*
+    Test Doc:
+    - Why: The screen and (later) the safety policy depend on the amp's current dB.
+    - Contract: parse_volume reads the db and mute attributes and the level text of <volume>.
+    - Usage Notes: Feed the raw HTTP body.
+    - Quality Contribution: Catches attribute parsing that confuses db with offsetDb.
+    - Worked Example: db="-39" offsetDb="0" mute="0" >70 -> ok, -39, false, 70.
+    */
+    knob::VolumeInfo v = knob::parse_volume(kVolumeXml);
+    TEST_ASSERT_TRUE(v.ok);
+    TEST_ASSERT_EQUAL_DOUBLE(-39, v.db);
+    TEST_ASSERT_FALSE(v.mute);
+    TEST_ASSERT_EQUAL_INT(70, v.level);
+    knob::VolumeInfo m = knob::parse_volume("<volume db=\"-45.5\" mute=\"1\">60</volume>");
+    TEST_ASSERT_TRUE(m.ok);
+    TEST_ASSERT_EQUAL_DOUBLE(-45.5, m.db);
+    TEST_ASSERT_TRUE(m.mute);
+}
+
+void given_missing_or_garbled_db_when_parsed_then_not_ok() {
+    /*
+    Test Doc:
+    - Why: Fail closed: an unknown volume must never be treated as a number (plan review finding 1).
+    - Contract: parse_volume.ok is false when db is absent, empty, non-numeric, or not finite; or the body is not <volume>.
+    - Usage Notes: Callers must check ok before using db.
+    - Quality Contribution: Catches a 0 dB default sneaking through.
+    - Worked Example: <volume mute="0">70</volume> -> ok=false; db="loud" -> ok=false; db="nan" -> ok=false.
+    */
+    TEST_ASSERT_FALSE(knob::parse_volume("<volume mute=\"0\">70</volume>").ok);
+    TEST_ASSERT_FALSE(knob::parse_volume("<volume db=\"\" mute=\"0\">70</volume>").ok);
+    TEST_ASSERT_FALSE(knob::parse_volume("<volume db=\"loud\">70</volume>").ok);
+    TEST_ASSERT_FALSE(knob::parse_volume("<volume db=\"nan\">70</volume>").ok);
+    TEST_ASSERT_FALSE(knob::parse_volume("<html>error</html>").ok);
+    TEST_ASSERT_FALSE(knob::parse_volume("").ok);
+}
+
+void given_real_status_response_when_parsed_then_source_fields() {
+    /*
+    Test Doc:
+    - Why: The idle screen shows the current source and volume.
+    - Contract: parse_status extracts service, title1, inputTypeIndex, state, db and mute from <status>.
+    - Usage Notes: <db> may be absent for some services; check has_db.
+    - Quality Contribution: Catches matching <title1> inside <twoline_title1>.
+    - Worked Example: real capture -> Capture / "Optical 1" / optical-1 / stream / -39 dB.
+    */
+    knob::StatusInfo s = knob::parse_status(kStatusXml);
+    TEST_ASSERT_TRUE(s.ok);
+    TEST_ASSERT_EQUAL_STRING("Capture", s.service.c_str());
+    TEST_ASSERT_EQUAL_STRING("Optical 1", s.title.c_str());
+    TEST_ASSERT_EQUAL_STRING("optical-1", s.input_type_index.c_str());
+    TEST_ASSERT_EQUAL_STRING("stream", s.state.c_str());
+    TEST_ASSERT_TRUE(s.has_db);
+    TEST_ASSERT_EQUAL_DOUBLE(-39, s.db);
+    TEST_ASSERT_FALSE(s.mute);
+}
+
+void given_status_with_entities_and_no_db_when_parsed_then_decoded_and_flagged() {
+    /*
+    Test Doc:
+    - Why: Track titles contain &amp; etc., and some sources omit <db>.
+    - Contract: XML entities in text are decoded; has_db is false without <db>.
+    - Usage Notes: Titles are shown on screen as-is after decoding.
+    - Quality Contribution: Catches "&amp;" on screen and a phantom 0 dB.
+    - Worked Example: <title1>Simon &amp; Garfunkel</title1> -> "Simon & Garfunkel".
+    */
+    knob::StatusInfo s = knob::parse_status(
+        "<status><service>Spotify</service><title1>Simon &amp; Garfunkel &lt;Live&gt;</title1>"
+        "<state>play</state><mute>1</mute></status>");
+    TEST_ASSERT_TRUE(s.ok);
+    TEST_ASSERT_EQUAL_STRING("Simon & Garfunkel <Live>", s.title.c_str());
+    TEST_ASSERT_FALSE(s.has_db);
+    TEST_ASSERT_TRUE(s.mute);
+    TEST_ASSERT_FALSE(knob::parse_status("<volume db=\"-3\"/>").ok);
+}
+
+int main() {
+    UNITY_BEGIN();
+    RUN_TEST(given_real_volume_response_when_parsed_then_db_mute_level);
+    RUN_TEST(given_missing_or_garbled_db_when_parsed_then_not_ok);
+    RUN_TEST(given_real_status_response_when_parsed_then_source_fields);
+    RUN_TEST(given_status_with_entities_and_no_db_when_parsed_then_decoded_and_flagged);
+    return UNITY_END();
+}
diff --git a/firmware/test/test_config/test_config.cpp b/firmware/test/test_config/test_config.cpp
new file mode 100644
index 0000000..79ad66d
--- /dev/null
+++ b/firmware/test/test_config/test_config.cpp
@@ -0,0 +1,118 @@
+#include <unity.h>
+
+#include "config.h"
+
+using knob::Config;
+
+static Config valid() {
+    Config c;
+    c.wifi_ssid = "home";
+    c.wifi_pass = "secret";
+    c.host = "192.168.1.67";
+    return c;
+}
+
+void setUp() {}
+void tearDown() {}
+
+void given_complete_safe_config_when_validated_then_ok() {
+    /*
+    Test Doc:
+    - Why: A complete, safe configuration must be accepted or the device never joins Wi-Fi.
+    - Contract: validate_config returns "" for defaults plus SSID, password and host.
+    - Usage Notes: The NVS adapter validates on boot; invalid config keeps the device offline and says why.
+    - Quality Contribution: Catches over-strict validation.
+    - Worked Example: ssid=home, pass=secret, host=192.168.1.67, defaults -> "".
+    */
+    TEST_ASSERT_EQUAL_STRING("", knob::validate_config(valid()).c_str());
+}
+
+void given_missing_network_or_host_when_validated_then_plain_error() {
+    /*
+    Test Doc:
+    - Why: The screen shows the first config problem in plain words.
+    - Contract: Empty SSID, empty host, or an out-of-range port is rejected with a non-empty message.
+    - Usage Notes: Messages are shown verbatim on screen and serial.
+    - Quality Contribution: Catches a device that tries to connect with nothing configured.
+    - Worked Example: ssid="" -> "Wi-Fi not set up (run just fw-wifi)".
+    */
+    Config c = valid();
+    c.wifi_ssid = "";
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c = valid();
+    c.host = "";
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c = valid();
+    c.port = 0;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c.port = 70000;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+}
+
+void given_unsafe_volume_limits_when_validated_then_rejected() {
+    /*
+    Test Doc:
+    - Why: Safety-first (constitution I): limits above -24 dB or oversized steps could make loud jumps.
+    - Contract: max_db and source_safe_db must be <= -24; step_db must be in (0, 3].
+    - Usage Notes: Mirrors scripts/bluos_source.py safe_abs_db_value (-24 cap); max_db and step bounds are firmware tightenings.
+    - Quality Contribution: Catches unsafe config reaching the amp policy.
+    - Worked Example: max_db=-20 -> error; source_safe_db=-10 -> error; step_db=5 -> error; step_db=0 -> error.
+    */
+    Config c = valid();
+    c.max_db = -20;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c = valid();
+    c.source_safe_db = -10;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c = valid();
+    c.step_db = 5;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+    c.step_db = 0;
+    TEST_ASSERT_TRUE(knob::validate_config(c).size() > 0);
+}
+
+void given_serial_set_commands_when_applied_then_valid_values_stick_and_invalid_are_refused() {
+    /*
+    Test Doc:
+    - Why: `just fw-wifi` and the serial console configure the device one key at a time.
+    - Contract: apply_setting updates the key on success; on an invalid value or unknown key it returns an error and changes nothing.
+    - Usage Notes: Values may contain spaces (SSIDs, passwords); numbers must parse fully.
+    - Quality Contribution: Catches partial writes and lenient number parsing ("-20dB").
+    - Worked Example: set max_db -30 -> ok; set max_db -10 -> refused (still -30); set port 12x -> refused.
+    */
+    Config c = valid();
+    TEST_ASSERT_EQUAL_STRING("", knob::apply_setting(c, "wifi_ssid", "My Home Net").c_str());
+    TEST_ASSERT_EQUAL_STRING("My Home Net", c.wifi_ssid.c_str());
+    TEST_ASSERT_EQUAL_STRING("", knob::apply_setting(c, "max_db", "-30").c_str());
+    TEST_ASSERT_EQUAL_DOUBLE(-30, c.max_db);
+    TEST_ASSERT_TRUE(knob::apply_setting(c, "max_db", "-10").size() > 0);
+    TEST_ASSERT_EQUAL_DOUBLE(-30, c.max_db);
+    TEST_ASSERT_TRUE(knob::apply_setting(c, "max_db", "-20dB").size() > 0);
+    TEST_ASSERT_TRUE(knob::apply_setting(c, "port", "12x").size() > 0);
+    TEST_ASSERT_EQUAL_INT(11000, c.port);
+    TEST_ASSERT_TRUE(knob::apply_setting(c, "colour", "blue").size() > 0);
+}
+
+void given_keys_when_checked_then_only_password_is_secret() {
+    /*
+    Test Doc:
+    - Why: The Wi-Fi password must never be echoed to serial or screen.
+    - Contract: is_secret_key is true for wifi_pass only.
+    - Usage Notes: The console masks secret values in `show`.
+    - Quality Contribution: Catches a password leaking through `show`.
+    - Worked Example: wifi_pass -> true; wifi_ssid -> false.
+    */
+    TEST_ASSERT_TRUE(knob::is_secret_key("wifi_pass"));
+    TEST_ASSERT_FALSE(knob::is_secret_key("wifi_ssid"));
+    TEST_ASSERT_FALSE(knob::is_secret_key("host"));
+}
+
+int main() {
+    UNITY_BEGIN();
+    RUN_TEST(given_complete_safe_config_when_validated_then_ok);
+    RUN_TEST(given_missing_network_or_host_when_validated_then_plain_error);
+    RUN_TEST(given_unsafe_volume_limits_when_validated_then_rejected);
+    RUN_TEST(given_serial_set_commands_when_applied_then_valid_values_stick_and_invalid_are_refused);
+    RUN_TEST(given_keys_when_checked_then_only_password_is_secret);
+    return UNITY_END();
+}
diff --git a/firmware/test/test_timing/test_timing.cpp b/firmware/test/test_timing/test_timing.cpp
new file mode 100644
index 0000000..19cec83
--- /dev/null
+++ b/firmware/test/test_timing/test_timing.cpp
@@ -0,0 +1,53 @@
+#include <unity.h>
+
+#include "timing.h"
+
+void setUp() {}
+void tearDown() {}
+
+void given_repeated_failures_when_backing_off_then_doubles_to_cap_and_resets_on_success() {
+    /*
+    Test Doc:
+    - Why: rules.md: the daemon MUST handle amplifier unreachability without retry storms.
+    - Contract: on_failure returns min, 2*min, 4*min ... capped at max; on_success resets to min.
+    - Usage Notes: Use the returned value as the wait before the next poll.
+    - Quality Contribution: Catches tight retry loops when the amp is off.
+    - Worked Example: min 1000, max 8000 -> 1000, 2000, 4000, 8000, 8000; success -> 1000.
+    */
+    knob::Backoff b(1000, 8000);
+    TEST_ASSERT_EQUAL_UINT32(1000, b.on_failure());
+    TEST_ASSERT_EQUAL_UINT32(2000, b.on_failure());
+    TEST_ASSERT_EQUAL_UINT32(4000, b.on_failure());
+    TEST_ASSERT_EQUAL_UINT32(8000, b.on_failure());
+    TEST_ASSERT_EQUAL_UINT32(8000, b.on_failure());
+    b.on_success();
+    TEST_ASSERT_EQUAL_UINT32(1000, b.on_failure());
+}
+
+void given_inactivity_when_time_passes_then_dims_and_wakes_on_touch() {
+    /*
+    Test Doc:
+    - Why: AC-09: the screen dims after inactivity and wakes on the next knob event or status change.
+    - Contract: dimmed(now) is true once now - last touch >= dim_after; touch() wakes it; millis() wrap is handled.
+    - Usage Notes: Call touch() on knob events and on amp volume/source changes.
+    - Quality Contribution: Catches a screen that never dims or never wakes, and the 49-day millis() wrap.
+    - Worked Example: dim_after 30000; touch at 0 -> not dimmed at 29999, dimmed at 30000; touch at 31000 -> awake.
+    */
+    knob::Dimmer d(30000);
+    d.touch(0);
+    TEST_ASSERT_FALSE(d.dimmed(29999));
+    TEST_ASSERT_TRUE(d.dimmed(30000));
+    d.touch(31000);
+    TEST_ASSERT_FALSE(d.dimmed(31000));
+    knob::Dimmer w(30000);
+    w.touch(0xFFFFF000u);
+    TEST_ASSERT_FALSE(w.dimmed(0x00000100u));
+    TEST_ASSERT_TRUE(w.dimmed(0xFFFFF000u + 30000u));
+}
+
+int main() {
+    UNITY_BEGIN();
+    RUN_TEST(given_repeated_failures_when_backing_off_then_doubles_to_cap_and_resets_on_success);
+    RUN_TEST(given_inactivity_when_time_passes_then_dims_and_wakes_on_touch);
+    return UNITY_END();
+}
